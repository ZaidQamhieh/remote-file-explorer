<?xml version="1.0" encoding="utf-8"?>
<!-- Only app cache roots are shareable. Update APKs use external cache and
     temporary previews use internal cache. Never expose all external storage
     or durable app files through this provider. -->
<paths>
    <external-cache-path name="external_cache" path="." />
    <cache-path name="cache" path="." />
</paths>
