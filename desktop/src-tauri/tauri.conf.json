{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RFE Desktop",
  "version": "0.1.0",
  "identifier": "app.rfe.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "RFE Desktop", "width": 780, "height": 600, "minWidth": 520, "minHeight": 420 }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; connect-src ipc: http://ipc.localhost; style-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
